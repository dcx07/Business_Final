<Window
    x:Class="BusinessFinal.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BusinessFinal"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FocusFlow WinUI 3">

    <Grid Padding="24" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
        <StackPanel>
            <TextBlock Text="FocusFlow" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="任务管理 + 番茄钟（WinUI 3 版）" Opacity="0.75" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="TaskInput" Width="420" PlaceholderText="输入任务，例如：完成项目文档" />
            <Button Content="添加" Click="AddTask_Click" />
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="2*,*" ColumnSpacing="12">
            <ListView x:Name="TaskListView">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:TaskItem">
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Padding="8">
                            <TextBlock Grid.Column="0" Text="{x:Bind Title}" TextDecorations="{x:Bind Decoration}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="完成/撤销" Tag="{x:Bind Id}" Click="ToggleTask_Click" />
                            <Button Grid.Column="2" Content="删除" Tag="{x:Bind Id}" Click="DeleteTask_Click" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Column="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock Text="番茄钟" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="TimerText" Text="25:00" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Button Content="开始" Click="Start_Click" />
                    <Button Content="暂停" Click="Pause_Click" />
                    <Button Content="重置" Click="Reset_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
