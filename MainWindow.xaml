<Window
    x:Class="BusinessFinal.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BusinessFinal"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="FocusFlow WinUI 3">

    <ScrollViewer
        HorizontalScrollMode="Enabled"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollMode="Disabled"
        VerticalScrollBarVisibility="Disabled"
        ZoomMode="Disabled">
    <Grid x:Name="RootGrid" MinWidth="900" Padding="24" RowDefinitions="Auto,Auto,*" RowSpacing="16" HorizontalAlignment="Stretch">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="WindowWidthStates">
                    <VisualState x:Name="Compact">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Padding" Value="16" />
                            <Setter Target="AppTitle.FontSize" Value="26" />
                            <Setter Target="InputGrid.ColumnDefinitions" Value="*" />
                            <Setter Target="InputGrid.RowDefinitions" Value="Auto,Auto" />
                            <Setter Target="TaskInput.(Grid.Row)" Value="0" />
                            <Setter Target="TaskInput.(Grid.Column)" Value="0" />
                            <Setter Target="TaskInput.MinWidth" Value="0" />
                            <Setter Target="AddTaskButton.(Grid.Row)" Value="1" />
                            <Setter Target="AddTaskButton.(Grid.Column)" Value="0" />
                            <Setter Target="AddTaskButton.HorizontalAlignment" Value="Stretch" />
                            <Setter Target="MainRegionGrid.ColumnDefinitions" Value="*" />
                            <Setter Target="MainRegionGrid.RowDefinitions" Value="Auto,Auto" />
                            <Setter Target="TaskListView.(Grid.Row)" Value="0" />
                            <Setter Target="TaskListView.(Grid.Column)" Value="0" />
                            <Setter Target="TimerPanel.(Grid.Row)" Value="1" />
                            <Setter Target="TimerPanel.(Grid.Column)" Value="0" />
                            <Setter Target="TimerPanel.HorizontalAlignment" Value="Stretch" />
                            <Setter Target="TimerPanel.Width" Value="Auto" />
                            <Setter Target="TimerPanel.MinWidth" Value="0" />
                            <Setter Target="TimerPanel.MaxWidth" Value="Infinity" />
                            <Setter Target="TimerText.FontSize" Value="30" />
                            <Setter Target="TimerActions.Orientation" Value="Vertical" />
                            <Setter Target="TimerActions.HorizontalAlignment" Value="Center" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Medium">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="860" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Padding" Value="20" />
                            <Setter Target="AppTitle.FontSize" Value="30" />
                            <Setter Target="InputGrid.ColumnDefinitions" Value="*,Auto" />
                            <Setter Target="InputGrid.RowDefinitions" Value="Auto" />
                            <Setter Target="TaskInput.(Grid.Row)" Value="0" />
                            <Setter Target="TaskInput.(Grid.Column)" Value="0" />
                            <Setter Target="TaskInput.MinWidth" Value="0" />
                            <Setter Target="AddTaskButton.(Grid.Row)" Value="0" />
                            <Setter Target="AddTaskButton.(Grid.Column)" Value="1" />
                            <Setter Target="AddTaskButton.HorizontalAlignment" Value="Stretch" />
                            <Setter Target="MainRegionGrid.ColumnDefinitions" Value="*,320" />
                            <Setter Target="MainRegionGrid.RowDefinitions" Value="*" />
                            <Setter Target="TaskListView.(Grid.Row)" Value="0" />
                            <Setter Target="TaskListView.(Grid.Column)" Value="0" />
                            <Setter Target="TimerPanel.(Grid.Row)" Value="0" />
                            <Setter Target="TimerPanel.(Grid.Column)" Value="1" />
                            <Setter Target="TimerPanel.HorizontalAlignment" Value="Stretch" />
                            <Setter Target="TimerPanel.Width" Value="320" />
                            <Setter Target="TimerPanel.MinWidth" Value="320" />
                            <Setter Target="TimerPanel.MaxWidth" Value="320" />
                            <Setter Target="TimerText.FontSize" Value="38" />
                            <Setter Target="TimerActions.Orientation" Value="Horizontal" />
                            <Setter Target="TimerActions.HorizontalAlignment" Value="Center" />
                        </VisualState.Setters>
                    </VisualState>

                    <VisualState x:Name="Wide">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1280" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="RootGrid.Padding" Value="24" />
                            <Setter Target="AppTitle.FontSize" Value="32" />
                            <Setter Target="InputGrid.ColumnDefinitions" Value="*,Auto" />
                            <Setter Target="InputGrid.RowDefinitions" Value="Auto" />
                            <Setter Target="TaskInput.(Grid.Row)" Value="0" />
                            <Setter Target="TaskInput.(Grid.Column)" Value="0" />
                            <Setter Target="TaskInput.MinWidth" Value="260" />
                            <Setter Target="AddTaskButton.(Grid.Row)" Value="0" />
                            <Setter Target="AddTaskButton.(Grid.Column)" Value="1" />
                            <Setter Target="AddTaskButton.HorizontalAlignment" Value="Stretch" />
                            <Setter Target="MainRegionGrid.ColumnDefinitions" Value="*,320" />
                            <Setter Target="MainRegionGrid.RowDefinitions" Value="*" />
                            <Setter Target="TaskListView.(Grid.Row)" Value="0" />
                            <Setter Target="TaskListView.(Grid.Column)" Value="0" />
                            <Setter Target="TimerPanel.(Grid.Row)" Value="0" />
                            <Setter Target="TimerPanel.(Grid.Column)" Value="1" />
                            <Setter Target="TimerPanel.HorizontalAlignment" Value="Stretch" />
                            <Setter Target="TimerPanel.Width" Value="320" />
                            <Setter Target="TimerPanel.MinWidth" Value="320" />
                            <Setter Target="TimerPanel.MaxWidth" Value="320" />
                            <Setter Target="TimerText.FontSize" Value="50" />
                            <Setter Target="TimerActions.Orientation" Value="Horizontal" />
                            <Setter Target="TimerActions.HorizontalAlignment" Value="Center" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <StackPanel>
                <TextBlock x:Name="AppTitle" Text="FocusFlow" FontSize="32" FontWeight="SemiBold" />
                <TextBlock Text="任务管理 + 番茄钟" Opacity="0.75" />
            </StackPanel>

            <Grid x:Name="InputGrid" Grid.Row="1" ColumnDefinitions="*,Auto" RowDefinitions="Auto" ColumnSpacing="8" RowSpacing="8">
                <TextBox x:Name="TaskInput" Grid.Column="0" Grid.Row="0" MinWidth="0" PlaceholderText="输入任务，例如：完成项目文档" HorizontalAlignment="Stretch" CornerRadius="4" />
                <Button x:Name="AddTaskButton" Grid.Column="1" Grid.Row="0" Content="添加" Click="AddTask_Click" MinHeight="40" Padding="16,0" HorizontalAlignment="Stretch" CornerRadius="4" />
            </Grid>

            <Grid x:Name="MainRegionGrid" Grid.Row="2" ColumnDefinitions="*,320" RowDefinitions="*" ColumnSpacing="16" RowSpacing="16">
                <Border Grid.Row="0" Grid.Column="0" CornerRadius="8" Padding="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <ListView x:Name="TaskListView" MinHeight="240" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Enabled">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:TaskItem">
                                <Border Margin="0,4" MinWidth="0" Padding="12" CornerRadius="4" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                    <Grid ColumnSpacing="8" RowSpacing="8" ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="{x:Bind Title}" TextWrapping="WrapWholeWords" TextDecorations="{x:Bind Decoration}" VerticalAlignment="Center" MaxLines="3" />
                                        <Button Grid.Row="1" Grid.Column="1" Content="完成/撤销" Tag="{x:Bind Id}" Click="ToggleTask_Click" HorizontalAlignment="Stretch" Padding="12,4" MinHeight="32" CornerRadius="4" VerticalContentAlignment="Center" />
                                        <Button Grid.Row="1" Grid.Column="2" Content="删除" Tag="{x:Bind Id}" Click="DeleteTask_Click" HorizontalAlignment="Stretch" Padding="12,4" MinHeight="32" CornerRadius="4" VerticalContentAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>

                <Border x:Name="TimerPanel" Grid.Row="0" Grid.Column="1" CornerRadius="8" Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                        <TextBlock Text="番茄钟" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TimerText" Text="25:00" FontSize="50" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="NoWrap" />
                        <StackPanel x:Name="TimerActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Content="开始" Click="Start_Click" MinWidth="64" CornerRadius="4" />
                            <Button Content="暂停" Click="Pause_Click" MinWidth="64" CornerRadius="4" />
                            <Button Content="重置" Click="Reset_Click" MinWidth="64" CornerRadius="4" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
